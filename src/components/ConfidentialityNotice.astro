---
import { getPortfolioContent } from "../data/portfolio";
import type { Locale } from "../i18n/routes";

type Props = { locale: Locale };
const { locale } = Astro.props;
const { portfolioConfidentiality } = getPortfolioContent(locale);
---

<section id="confidentiality" class="quiet-note" aria-labelledby="confidentiality-title">
  <h2 id="confidentiality-title">{portfolioConfidentiality.title}</h2>
  <p>{portfolioConfidentiality.description}</p>
  <p>{portfolioConfidentiality.boundary}</p>
</section>
