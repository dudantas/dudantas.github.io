---
import Icon from "./Icon.astro";
import { getPortfolioContent } from "../data/portfolio";
import type { Locale } from "../i18n/routes";

type Props = { locale: Locale };
const { locale } = Astro.props;
const { siteCopy } = getPortfolioContent(locale);
---

<div class="theme-picker" data-theme-picker hidden>
  <p class="preference-label">{siteCopy.theme.label}</p>
  <div class="theme-options" role="group" aria-label={siteCopy.theme.label}>
    <button type="button" data-theme-option="light" aria-pressed="false"><Icon name="sun" />{siteCopy.theme.light}</button>
    <button type="button" data-theme-option="dark" aria-pressed="false"><Icon name="moon" />{siteCopy.theme.dark}</button>
  </div>
</div>
