---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseStudy from "../CaseStudy.astro";
import ConfidentialityNotice from "../ConfidentialityNotice.astro";
import Icon from "../Icon.astro";
import { getPortfolioContent } from "../../data/portfolio";
import { localizePath, type Locale } from "../../i18n/routes";

type Props = { locale: Locale };
const { locale } = Astro.props;
const {
  capabilities,
  caseStudies,
  featuredWork,
  homePage: content,
  impactHighlights,
  privateWork,
  profile,
  recommendations,
  selectedContributions,
  siteCopy,
  workIndex
} = getPortfolioContent(locale);

const indexEntries = workIndex.map((entry) => ({
  ...entry,
  work: featuredWork.find((work) => work.caseStudyId === entry.caseStudyId)!
}));
const primaryContributions = selectedContributions.slice(0, 4);
const additionalContributions = selectedContributions.slice(4);
---

<BaseLayout title={content.title} description={profile.description} locale={locale}>
  <main id="main-content">
    <header class="content-header home-introduction">
      <p class="eyebrow">{content.eyebrow}</p>
      <h1>{content.headline.map((line) => <span>{line}{" "}</span>)}</h1>
      <p class="content-lead">{content.introduction}</p>
    </header>

    <section id="featured-work" aria-label={content.eyebrow} class="work-index">
      {indexEntries.map((entry) => {
        const metric = entry.metricIndex === undefined ? undefined : entry.work.metrics[entry.metricIndex];
        return (
          <article class="work-entry">
            <div class="work-entry-grid">
              <div class="work-overview">
                <p class="eyebrow">{entry.category}</p>
                <h2>{entry.title}</h2>
                <p>{entry.summary}</p>
              </div>
              <div class="work-proof">
                <p class="eyebrow muted">{metric ? content.result : content.evidence}</p>
                {metric && <p class="work-result">{metric.value.replace(" -> ", " → ")}</p>}
                <p class="work-evidence">
                  {metric && <span>{metric.label}<span aria-hidden="true"> · </span></span>}
                  <a href={entry.work.url} target="_blank" rel="noreferrer">{entry.work.evidenceLabel}</a>
                </p>
              </div>
              <a class="text-link work-case-link" href={`#${entry.caseStudyId}`} aria-label={`${siteCopy.caseStudy}: ${entry.title}`}>
                {siteCopy.caseStudy}<Icon name="arrowRight" />
              </a>
            </div>
            {entry.note && <p class="work-note">{entry.note}</p>}
          </article>
        );
      })}
      <a class="text-link all-work-link" href="#case-studies">{content.allWork}<Icon name="arrowRight" /></a>
    </section>

    <ConfidentialityNotice locale={locale} />

    <section id="case-studies" class="content-section">
      <div class="section-heading"><h2>{content.caseStudiesTitle}</h2><p>{content.caseStudiesDescription}</p></div>
      <div class="disclosure-list">{caseStudies.map((study) => <CaseStudy locale={locale} study={study} />)}</div>
    </section>

    <section class="content-section supporting-work" aria-label={content.capabilitiesTitle}>
      <details id="capabilities" data-expandable class="disclosure">
        <summary><span class="disclosure-title">{content.capabilitiesTitle}</span><Icon name="caretDown" class="disclosure-indicator" /></summary>
        <div class="expertise-list">
          {capabilities.map((group) => (
            <div><h3>{group.title}</h3><p>{group.summary}</p><p class="technology-line">{group.skills.join(" · ")}</p></div>
          ))}
        </div>
      </details>
      <details id="impact-highlights" data-expandable class="disclosure">
        <summary><span class="disclosure-title">{content.measurementsTitle}</span><Icon name="caretDown" class="disclosure-indicator" /></summary>
        <div class="measurements-list">
          {impactHighlights.map((item) => (
            <article><h3>{item.value.replace(" -> ", " → ")}</h3><div><p class="measurement-label">{item.label}</p><p>{item.detail}</p>{item.url && <a class="text-link" href={item.url} target="_blank" rel="noreferrer">{item.evidenceLabel}<Icon name="arrowUpRight" /></a>}</div></article>
          ))}
        </div>
      </details>
      <details id="evidence" data-expandable class="disclosure">
        <summary><span class="disclosure-title">{content.contributionsTitle}</span><Icon name="caretDown" class="disclosure-indicator" /></summary>
        <div class="contribution-list">
          {primaryContributions.map((item) => (
            <article><p class="eyebrow">{item.category}</p><h3><a class="text-link" href={item.url} target="_blank" rel="noreferrer">{item.title}<Icon name="arrowUpRight" /></a></h3><p>{item.summary}</p><span class="evidence-status">{item.evidenceStatus}</span></article>
          ))}
          <details class="more-contributions disclosure">
            <summary><span>{content.moreContributions}</span><Icon name="caretDown" class="disclosure-indicator" /></summary>
            <div>{additionalContributions.map((item) => (
              <article><p class="eyebrow">{item.category}</p><h3><a class="text-link" href={item.url} target="_blank" rel="noreferrer">{item.title}<Icon name="arrowUpRight" /></a></h3><p>{item.summary}</p><span class="evidence-status">{item.evidenceStatus}</span></article>
            ))}</div>
          </details>
        </div>
      </details>
    </section>

    <section id="private-work" class="content-section compact-section">
      <p class="eyebrow">{content.privateTitle}</p>
      <h2>{privateWork.shortTitle}</h2>
      <p>{privateWork.shortSummary}</p>
      <p class="evidence-status">{privateWork.label} · {privateWork.reference}</p>
      <a class="text-link" href={localizePath("/about#private-work", locale)}>{content.privateLink}<Icon name="arrowRight" /></a>
    </section>
    <section id="recommendations" class="recommendation-line">
      <a class="text-link" href={recommendations.profileUrl} target="_blank" rel="noreferrer">{content.recommendationsLink}<Icon name="arrowUpRight" /></a>
    </section>
    <section id="contact" class="content-section closing-section">
      <h2>{content.contactTitle}</h2><p>{content.contactDescription}</p>
      <div class="action-row"><a class="button-primary" href={localizePath("/contact", locale)}>{siteCopy.discussProject}<Icon name="arrowRight" /></a><a class="text-link" href={localizePath("/services", locale)}>{siteCopy.viewServices}</a></div>
    </section>
  </main>
</BaseLayout>
