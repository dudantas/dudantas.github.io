---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import { profile, siteCopy } from "../data/portfolio";

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
const siteUrl = Astro.site ?? new URL("https://dudantas.github.io");
const canonicalUrl = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", siteUrl).href;
const socialImageUrl = new URL("/og-image.svg", siteUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Eduardo Dantas Portfolio" />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{title}</title>
  </head>
  <body id="top" class="text-slate-100">
    <a class="skip-link" href="#main-content">{siteCopy.skipLink}</a>
    <SiteHeader />
    <slot />
    <footer class="border-t border-white/10 py-8">
      <div class="page-shell flex flex-wrap items-center justify-between gap-5 text-sm text-slate-400">
        <div><p class="font-medium text-slate-200">{profile.name}</p><p class="mt-1">{siteCopy.footer}</p></div>
        <a class="text-link" href="#top">{siteCopy.backToTop} <span aria-hidden="true">↑</span></a>
      </div>
    </footer>
  </body>
</html>
