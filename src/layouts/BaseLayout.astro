---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import Icon from "../components/Icon.astro";
import { profile, siteCopy } from "../data/portfolio";

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
const siteUrl = Astro.site ?? new URL("https://dudantas.github.io");
const canonicalUrl = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", siteUrl).href;
const socialImageUrl = new URL("/og-image.svg", siteUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Eduardo Dantas Portfolio" />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{title}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">{siteCopy.skipLink}</a>
    <div class="site-layout">
      <SiteHeader />
      <div class="site-content">
        <slot />
        <footer class="site-footer">
          <p>{siteCopy.footer}</p>
          <div class="footer-socials">
            {profile.links.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{link.label}<Icon name="arrowUpRight" /></a>)}
          </div>
          <a class="text-link" href="#top">{siteCopy.backToTop}<Icon name="arrowUp" /></a>
        </footer>
      </div>
    </div>
  </body>
</html>

<script>
  function revealSection(hash: string) {
    let id: string;
    try { id = decodeURIComponent(hash.slice(1)); } catch { return; }
    const section = document.getElementById(id);
    if (section instanceof HTMLDetailsElement && (section.hasAttribute("data-case-study") || section.hasAttribute("data-expandable"))) {
      section.open = true;
      section.scrollIntoView({ block: "start" });
    }
  }

  revealSection(window.location.hash);
  window.addEventListener("hashchange", () => revealSection(window.location.hash));
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
    link.addEventListener("click", (event) => {
      if (!event.ctrlKey && !event.metaKey && !event.shiftKey && !event.altKey) revealSection(link.hash);
    });
  });
</script>
