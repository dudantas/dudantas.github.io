---
import BaseLayout from "../layouts/BaseLayout.astro";
import { contactPage as content, siteCopy } from "../data/portfolio";
---

<BaseLayout title={content.title} description={content.description}>
  <main id="main-content" class="py-14 sm:py-20">
    <div class="page-shell">
      <p class="page-eyebrow">{content.eyebrow}</p>
      <h1 class="page-title max-w-3xl">{content.headline}</h1>
      <p class="page-lead max-w-2xl">{content.lead}</p>

      <div class="mt-10 grid items-start gap-10 lg:mt-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
        <div>
          <div class="border-t border-sky-300/30 pt-6">
            <p class="text-base leading-7 text-slate-300">{content.channel.description}</p>
            <a class="button-primary mt-6" href={content.channel.href} target="_blank" rel="noreferrer">{content.channel.label} <span class="ml-2" aria-hidden="true">↗</span></a>
          </div>
          <div class="mt-9">
            <h2 class="text-lg font-semibold text-white">{content.nextTitle}</h2>
            <p class="mt-3 text-base leading-7 text-slate-400">{content.nextDescription}</p>
          </div>
          <div class="mt-8">
            <h2 class="text-lg font-semibold text-white">{content.rolesTitle}</h2>
            <p class="mt-3 text-base leading-7 text-slate-400">{content.rolesDescription}</p>
          </div>
          <aside class="mt-8 border-t border-white/10 pt-6">
            <h2 class="text-base font-semibold text-slate-200">{siteCopy.business.title}</h2>
            <p class="mt-3 text-sm leading-7 text-slate-400">{siteCopy.business.description}</p>
          </aside>
        </div>

        <section id="brief" class="surface p-6 sm:p-8">
          <h2 class="section-title">{content.briefTitle}</h2>
          <p class="mt-4 text-base leading-7 text-slate-400">{content.briefIntroduction}</p>
          <ol class="mt-6 grid gap-6">
            {content.brief.map((item, index) => (
              <li class="flex gap-4 border-t border-white/10 pt-5">
                <span class="mt-1 font-mono text-sm text-sky-300" aria-hidden="true">0{index + 1}</span>
                <div>
                  <h3 class="text-base font-semibold text-white">{item.title}</h3>
                  <p class="mt-2 text-base leading-7 text-slate-400">{item.description}</p>
                </div>
              </li>
            ))}
          </ol>
          <aside class="mt-8 border-l-2 border-amber-300/40 pl-5">
            <h3 class="text-sm font-semibold text-amber-100">{content.privacyTitle}</h3>
            <p class="mt-3 text-sm leading-7 text-slate-400">{content.privacyDescription}</p>
          </aside>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>
