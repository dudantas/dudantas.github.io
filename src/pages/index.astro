---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  caseStudies,
  featuredWork,
  heroMetrics,
  navItems,
  privateWork,
  profile,
  selectedContributions,
  skillGroups
} from "../data/portfolio";

const statusClass = (status: string) => {
  if (status.includes("Private")) return "border-amber-400/30 bg-amber-400/10 text-amber-100";
  if (status.includes("open") || status.includes("proposal")) return "border-sky-400/30 bg-sky-400/10 text-sky-100";
  return "border-emerald-400/30 bg-emerald-400/10 text-emerald-100";
};
---

<BaseLayout title="Eduardo Dantas - Software Engineer" description={profile.subtitle}>
  <div class="min-h-screen bg-slate-950 text-slate-100">
    <header class="sticky top-0 z-20 border-b border-white/10 bg-slate-950/85 backdrop-blur">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 sm:px-6 lg:px-8" aria-label="Main navigation">
        <a href="#top" class="font-mono text-sm font-semibold tracking-normal text-white">{profile.handle}</a>
        <div class="hidden items-center gap-6 text-sm text-slate-300 md:flex">
          {navItems.map((item) => (
            <a class="transition hover:text-white" href={item.href}>{item.label}</a>
          ))}
        </div>
        <a class="rounded-md border border-sky-400/40 px-3 py-2 text-sm font-medium text-sky-100 transition hover:border-sky-300 hover:bg-sky-400/10" href="#contact">
          Contact
        </a>
      </nav>
    </header>

    <main id="top">
      <section class="border-b border-white/10">
        <div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-6 md:py-24 lg:grid-cols-[1.2fr_0.8fr] lg:px-8">
          <div class="flex min-w-0 flex-col justify-center">
            <div class="mb-6 flex flex-wrap items-center gap-3">
              <span class="rounded-md border border-white/10 bg-white/5 px-3 py-1 text-sm text-slate-300">MMORPG systems</span>
              <span class="rounded-md border border-white/10 bg-white/5 px-3 py-1 text-sm text-slate-300">C++ / Lua</span>
              <span class="rounded-md border border-white/10 bg-white/5 px-3 py-1 text-sm text-slate-300">Open source infrastructure</span>
            </div>
            <h1 class="max-w-4xl break-words text-3xl font-semibold leading-tight text-white sm:text-5xl lg:text-6xl">
              {profile.headline}
            </h1>
            <p class="mt-6 max-w-3xl break-words text-base leading-7 text-slate-300 sm:text-xl sm:leading-8">
              {profile.subtitle}
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              {profile.links.map((link) => (
                <a class="rounded-md border border-white/15 bg-white/5 px-4 py-3 text-sm font-medium text-white transition hover:border-sky-300 hover:bg-sky-400/10" href={link.href} target="_blank" rel="noreferrer">
                  {link.label}
                </a>
              ))}
            </div>
          </div>

          <aside class="flex flex-col gap-5">
            <div class="overflow-hidden rounded-lg border border-white/10 bg-white/[0.03]">
              <div class="flex items-center gap-4 border-b border-white/10 p-5">
                <img class="h-16 w-16 rounded-md border border-white/10 bg-slate-900" src="https://github.com/dudantas.png" alt="Eduardo Dantas" loading="eager" />
                <div>
                  <p class="text-lg font-semibold text-white">{profile.name}</p>
                  <p class="text-sm text-slate-400">@{profile.handle} - {profile.location}</p>
                </div>
              </div>
              <div class="grid gap-px bg-white/10 sm:grid-cols-3 lg:grid-cols-1">
                {heroMetrics.map((metric) => (
                  <div class="bg-slate-950 p-5">
                    <p class="text-xs uppercase tracking-[0.18em] text-slate-500">{metric.label}</p>
                    <p class="mt-2 text-xl font-semibold text-white">{metric.value}</p>
                    <p class="mt-1 text-sm text-slate-400">{metric.detail}</p>
                  </div>
                ))}
              </div>
            </div>
          </aside>
        </div>
      </section>

      <section id="featured-work" class="border-b border-white/10 py-16 sm:py-20">
        <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
          <div class="max-w-3xl">
            <p class="font-mono text-sm uppercase tracking-[0.18em] text-sky-300">Featured Work</p>
            <h2 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">Selected systems with clear technical signal.</h2>
          </div>
          <div class="mt-10 grid gap-5 md:grid-cols-2">
            {featuredWork.map((work) => (
              <article class="rounded-lg border border-white/10 bg-white/[0.03] p-6">
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <p class="text-sm font-medium text-sky-200">{work.eyebrow}</p>
                  <span class={`rounded-md border px-2.5 py-1 text-xs font-medium ${statusClass(work.evidenceStatus)}`}>
                    {work.evidenceStatus}
                  </span>
                </div>
                <h3 class="mt-4 text-2xl font-semibold text-white">{work.title}</h3>
                <p class="mt-4 text-slate-300">{work.summary}</p>
                <div class="mt-6 rounded-md border border-white/10 bg-slate-950/70 p-4">
                  <p class="text-2xl font-semibold text-lime-200">{work.metric}</p>
                  <p class="mt-1 text-sm text-slate-400">{work.metricLabel}</p>
                </div>
                <p class="mt-5 text-sm leading-6 text-slate-400">{work.impact}</p>
                <div class="mt-5 flex flex-wrap gap-2">
                  {work.tags.map((tag) => (
                    <span class="rounded-md border border-white/10 px-2.5 py-1 text-xs text-slate-300">{tag}</span>
                  ))}
                </div>
                {"url" in work && work.url && (
                  <div class="mt-6 flex flex-wrap gap-3">
                    <a class="text-sm font-medium text-sky-300 hover:text-sky-200" href={work.url} target="_blank" rel="noreferrer">Public evidence</a>
                    {"relatedUrls" in work && work.relatedUrls?.map((url) => (
                      <a class="text-sm font-medium text-sky-300 hover:text-sky-200" href={url} target="_blank" rel="noreferrer">Related PR</a>
                    ))}
                  </div>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="case-studies" class="border-b border-white/10 py-16 sm:py-20">
        <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
          <div class="max-w-3xl">
            <p class="font-mono text-sm uppercase tracking-[0.18em] text-sky-300">Case Studies</p>
            <h2 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">Engineering narratives backed by public evidence.</h2>
          </div>
          <div class="mt-10 grid gap-5">
            {caseStudies.map((study) => (
              <article class="rounded-lg border border-white/10 bg-white/[0.03] p-6 lg:grid lg:grid-cols-[0.9fr_1.1fr] lg:gap-8">
                <div>
                  <div class="flex flex-wrap items-center gap-3">
                    <h3 class="text-2xl font-semibold text-white">{study.title}</h3>
                    <span class={`rounded-md border px-2.5 py-1 text-xs font-medium ${statusClass(study.evidenceStatus)}`}>{study.evidenceStatus}</span>
                  </div>
                  <p class="mt-4 text-slate-300">{study.context}</p>
                  <p class="mt-4 text-sm leading-6 text-slate-400"><strong class="font-semibold text-slate-200">Problem:</strong> {study.problem}</p>
                  <p class="mt-4 text-sm leading-6 text-slate-400"><strong class="font-semibold text-slate-200">Solution:</strong> {study.solution}</p>
                  <p class="mt-4 text-sm leading-6 text-slate-400"><strong class="font-semibold text-lime-200">Impact:</strong> {study.impact}</p>
                </div>
                <div class="mt-6 grid gap-5 lg:mt-0">
                  <div>
                    <h4 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-400">What I owned</h4>
                    <ul class="mt-3 grid gap-2 text-sm text-slate-300 sm:grid-cols-2">
                      {study.whatIOwned.map((item) => (
                        <li class="rounded-md border border-white/10 bg-slate-950/60 px-3 py-2">{item}</li>
                      ))}
                    </ul>
                  </div>
                  <div>
                    <h4 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-400">Evidence</h4>
                    <div class="mt-3 flex flex-wrap gap-3">
                      {study.evidence.map((url, index) => (
                        <a class="rounded-md border border-sky-400/30 px-3 py-2 text-sm font-medium text-sky-200 hover:bg-sky-400/10" href={url} target="_blank" rel="noreferrer">
                          Public link {index + 1}
                        </a>
                      ))}
                    </div>
                  </div>
                  <div>
                    <h4 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-400">Technologies</h4>
                    <div class="mt-3 flex flex-wrap gap-2">
                      {study.technologies.map((tech) => (
                        <span class="rounded-md border border-white/10 px-2.5 py-1 text-xs text-slate-300">{tech}</span>
                      ))}
                    </div>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="selected-contributions" class="border-b border-white/10 py-16 sm:py-20">
        <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
          <div class="max-w-3xl">
            <p class="font-mono text-sm uppercase tracking-[0.18em] text-sky-300">Selected Contributions</p>
            <h2 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">Secondary proof across stability, tooling, build, and protocol work.</h2>
          </div>
          <div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            {selectedContributions.map((item) => (
              <article class="rounded-lg border border-white/10 bg-white/[0.03] p-5">
                <div class="flex flex-wrap gap-2">
                  <span class={`rounded-md border px-2.5 py-1 text-xs font-medium ${statusClass(item.evidenceStatus)}`}>{item.evidenceStatus}</span>
                  <span class="rounded-md border border-white/10 px-2.5 py-1 text-xs text-slate-300">{item.category}</span>
                </div>
                <h3 class="mt-4 text-lg font-semibold text-white">{item.title}</h3>
                <p class="mt-3 text-sm leading-6 text-slate-400">{item.summary}</p>
                <a class="mt-5 inline-flex text-sm font-medium text-sky-300 hover:text-sky-200" href={item.url} target="_blank" rel="noreferrer">View evidence</a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="skills" class="border-b border-white/10 py-16 sm:py-20">
        <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
          <div class="max-w-3xl">
            <p class="font-mono text-sm uppercase tracking-[0.18em] text-sky-300">Skills</p>
            <h2 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">Skills grounded in shipped and reviewed work.</h2>
          </div>
          <div class="mt-10 grid gap-5 md:grid-cols-3">
            {skillGroups.map((group) => (
              <article class="rounded-lg border border-white/10 bg-white/[0.03] p-6">
                <h3 class="text-xl font-semibold text-white">{group.title}</h3>
                <div class="mt-5 flex flex-wrap gap-2">
                  {group.skills.map((skill) => (
                    <span class="rounded-md border border-white/10 bg-slate-950/60 px-3 py-2 text-sm text-slate-300">{skill}</span>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="private-work" class="border-b border-white/10 py-16 sm:py-20">
        <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
          <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
            <div>
              <p class="font-mono text-sm uppercase tracking-[0.18em] text-sky-300">Private Work</p>
              <h2 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">{privateWork.title}</h2>
              <span class={`mt-5 inline-flex rounded-md border px-3 py-1.5 text-sm font-medium ${statusClass(privateWork.label)}`}>{privateWork.label}</span>
              <p class="mt-6 text-lg leading-8 text-slate-300">{privateWork.summary}</p>
            </div>
            <div class="grid gap-5 md:grid-cols-2">
              <article class="rounded-lg border border-white/10 bg-white/[0.03] p-6">
                <h3 class="text-xl font-semibold text-white">Public-safe claims</h3>
                <ul class="mt-5 grid gap-3 text-sm leading-6 text-slate-300">
                  {privateWork.whatCanBeSaid.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
              <article class="rounded-lg border border-white/10 bg-white/[0.03] p-6">
                <h3 class="text-xl font-semibold text-white">Kept private</h3>
                <ul class="mt-5 grid gap-3 text-sm leading-6 text-slate-300">
                  {privateWork.whatStaysPrivate.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            </div>
          </div>
        </div>
      </section>

      <section id="contact" class="py-16 sm:py-20">
        <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
          <div class="rounded-lg border border-white/10 bg-white/[0.03] p-8 sm:p-10">
            <p class="font-mono text-sm uppercase tracking-[0.18em] text-sky-300">Contact</p>
            <h2 class="mt-3 max-w-3xl text-3xl font-semibold text-white sm:text-4xl">Available for senior engineering work in complex game systems.</h2>
            <p class="mt-5 max-w-3xl text-slate-300">
              Best fit: game server engineering, game client engineering, performance work, protocol tooling, open-source infrastructure, and production reliability.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              {profile.links.map((link) => (
                <a class="rounded-md border border-white/15 bg-white/5 px-4 py-3 text-sm font-medium text-white transition hover:border-sky-300 hover:bg-sky-400/10" href={link.href} target="_blank" rel="noreferrer">
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
