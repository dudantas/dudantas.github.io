---
import BaseLayout from "../layouts/BaseLayout.astro";
import { caseStudies, serviceOfferings, servicesPage as content, siteCopy } from "../data/portfolio";
---

<BaseLayout title={content.title} description={content.description}>
  <main id="main-content">
    <section class="page-section">
      <div class="page-shell grid items-center gap-10 lg:grid-cols-[1.4fr_0.7fr] lg:gap-16">
        <div>
          <p class="page-eyebrow">{content.eyebrow}</p>
          <h1 class="page-title">{content.headline}</h1>
          <p class="page-lead">{content.lead}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="button-primary" href="/contact">{content.primaryCta}</a>
            <a class="button-secondary" href="#engagements">{content.secondaryCta}</a>
          </div>
        </div>
        <aside class="border-l-2 border-lime-300/40 pl-6">
          <h2 class="text-lg font-semibold text-white">{content.fitTitle}</h2>
          <ul class="mt-5 grid gap-5 text-base leading-7 text-slate-400">
            {content.fit.map((item) => <li>{item}</li>)}
          </ul>
        </aside>
      </div>
    </section>

    <section id="engagements" class="page-section">
      <div class="page-shell">
        <h2 class="section-title">{content.offersTitle}</h2>
        <p class="mt-4 max-w-3xl text-base leading-7 text-slate-400">{content.offersDescription}</p>
        <div class="mt-9 grid gap-5 lg:grid-cols-3">
          {serviceOfferings.map((offer, index) => (
            <article id={offer.id} class="surface flex min-w-0 flex-col p-6 sm:p-7">
              <p class="font-mono text-sm text-lime-200" aria-hidden="true">0{index + 1}</p>
              <h3 class="mt-4 text-2xl font-semibold leading-snug text-white">{offer.title}</h3>
              <p class="mt-4 text-base leading-7 text-slate-300">{offer.summary}</p>
              <h4 class="mt-6 text-sm font-semibold text-slate-200">{content.deliverablesLabel}</h4>
              <ul class="mt-3 grid list-disc gap-3 pl-4 text-base leading-7 text-slate-400 marker:text-sky-300/70">
                {offer.deliverables.map((item) => <li class="pl-1">{item}</li>)}
              </ul>
              <details class="mt-6 border-y border-white/10 py-4">
                <summary class="cursor-pointer text-sm font-medium text-sky-200">{content.scopeLabel}</summary>
                <div class="mt-4 text-sm leading-6 text-slate-400">
                  <h4 class="font-semibold text-slate-200">{content.outsideLabel}</h4>
                  <p class="mt-2">{offer.outsideScope}</p>
                  <h4 class="mt-4 font-semibold text-slate-200">{content.assessmentLabel}</h4>
                  <p class="mt-2">{offer.assessment}</p>
                </div>
              </details>
              <div class="mt-auto pt-5">
                <p class="text-sm text-slate-500">{content.evidenceLabel}</p>
                <div class="mt-3 grid gap-3">
                  {offer.caseStudyIds.map((id) => {
                    const study = caseStudies.find((item) => item.id === id)!;
                    return <a class="text-link leading-6" href={`/#${study.id}`}>{study.title} <span aria-hidden="true">↗</span></a>;
                  })}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="opentibia" class="page-section">
      <div class="page-shell grid gap-8 lg:grid-cols-2 lg:gap-16">
        <div>
          <p class="page-eyebrow">{content.openTibia.eyebrow}</p>
          <h2 class="section-title mt-4">{content.openTibia.title}</h2>
          <p class="mt-5 text-base leading-7 text-slate-300">{content.openTibia.description}</p>
          <a class="text-link mt-6 inline-flex" href="/#featured-work">{content.openTibia.linkLabel} <span class="ml-2" aria-hidden="true">→</span></a>
        </div>
        <div class="surface grid content-center gap-5 p-6 text-base leading-7 text-slate-400 sm:p-8">
          <p>{content.openTibia.scope}</p>
          <p>{content.openTibia.rights}</p>
        </div>
      </div>
    </section>

    <section class="page-section">
      <div class="page-shell">
        <h2 class="section-title max-w-2xl">{content.processTitle}</h2>
        <ol class="mt-9 grid gap-7 sm:grid-cols-2 lg:grid-cols-5">
          {content.process.map((step, index) => (
            <li class="border-t border-sky-300/25 pt-5">
              <p class="font-mono text-sm text-sky-300" aria-hidden="true">0{index + 1}</p>
              <h3 class="mt-3 text-lg font-semibold text-white">{step.title}</h3>
              <p class="mt-2 text-base leading-7 text-slate-400">{step.description}</p>
            </li>
          ))}
        </ol>
        <div class="mt-10 border-l-2 border-white/20 pl-5">
          <h3 class="text-base font-semibold text-slate-200">{content.supportTitle}</h3>
          <p class="mt-2 max-w-4xl text-base leading-7 text-slate-400">{content.supportDescription}</p>
        </div>
      </div>
    </section>

    <section class="py-14 sm:py-20">
      <div class="page-shell">
        <div class="surface p-7 sm:p-10">
          <h2 class="section-title">{content.closingTitle}</h2>
          <p class="mt-4 max-w-3xl text-base leading-7 text-slate-400">{content.closingDescription}</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a class="button-primary" href="/contact">{siteCopy.discussProject}</a>
            <a class="button-secondary" href="/contact#brief">{content.assessmentCta}</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
