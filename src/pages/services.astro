---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { caseStudies, serviceOfferings, servicesPage as content, siteCopy } from "../data/portfolio";
---

<BaseLayout title={content.title} description={content.description}>
  <main id="main-content">
    <header class="content-header">
      <p class="eyebrow">{content.eyebrow}</p>
      <h1>{content.headline}</h1>
      <p class="content-lead">{content.lead}</p>
      <div class="action-row">
        <a class="button-primary" href="/contact">{content.primaryCta}<Icon name="arrowRight" /></a>
        <a class="text-link" href="#engagements">{content.secondaryCta}</a>
      </div>
    </header>

    <aside class="context-strip">
      <h2>{content.fitTitle}</h2>
      <ul class="plain-list">{content.fit.map((item) => <li>{item}</li>)}</ul>
    </aside>

    <section id="engagements" class="content-section">
      <div class="section-heading"><h2>{content.offersTitle}</h2><p>{content.offersDescription}</p></div>
      <div class="disclosure-list">
        {serviceOfferings.map((offer, index) => (
          <details id={offer.id} data-expandable class="service-offer disclosure">
            <summary>
              <span class="service-number eyebrow" aria-hidden="true">0{index + 1}</span>
              <span class="service-overview"><span class="disclosure-title">{offer.title}</span><span class="service-description">{offer.summary}</span></span>
              <Icon name="caretDown" class="disclosure-indicator" />
            </summary>
            <div class="service-body">
              <div class="service-details-grid">
                <div><h3>{content.deliverablesLabel}</h3><ul class="bullet-list">{offer.deliverables.map((item) => <li>{item}</li>)}</ul></div>
                <div class="prose-stack">
                  <h3>{content.scopeLabel}</h3>
                  <div><h4>{content.outsideLabel}</h4><p>{offer.outsideScope}</p></div>
                  <div><h4>{content.assessmentLabel}</h4><p>{offer.assessment}</p></div>
                </div>
              </div>
              {offer.caseStudyIds.length > 0 && (
                <div class="related-work">
                  <h3>{content.evidenceLabel}</h3>
                  <div class="compact-links">
                    {offer.caseStudyIds.map((id) => {
                      const study = caseStudies.find((item) => item.id === id)!;
                      return <a class="text-link" href={`/#${study.id}`}>{study.title}<Icon name="arrowRight" /></a>;
                    })}
                  </div>
                </div>
              )}
            </div>
          </details>
        ))}
      </div>
    </section>

    <section id="opentibia" class="content-section editorial-section">
      <div class="section-heading"><p class="eyebrow">{content.openTibia.eyebrow}</p><h2>{content.openTibia.title}</h2></div>
      <div class="prose-stack">
        <p>{content.openTibia.description}</p><p>{content.openTibia.scope}</p><p>{content.openTibia.rights}</p>
        <a class="text-link" href="/#featured-work">{content.openTibia.linkLabel}<Icon name="arrowRight" /></a>
      </div>
    </section>

    <section class="content-section">
      <div class="section-heading"><h2>{content.processTitle}</h2></div>
      <ol class="process-list">
        {content.process.map((step, index) => (
          <li><span class="eyebrow" aria-hidden="true">0{index + 1}</span><h3>{step.title}</h3><p>{step.description}</p></li>
        ))}
      </ol>
      <aside class="quiet-note"><h3>{content.supportTitle}</h3><p>{content.supportDescription}</p></aside>
    </section>

    <section class="content-section closing-section">
      <h2>{content.closingTitle}</h2><p>{content.closingDescription}</p>
      <div class="action-row">
        <a class="button-primary" href="/contact">{siteCopy.discussProject}<Icon name="arrowRight" /></a>
        <a class="text-link" href="/contact#brief">{content.assessmentCta}</a>
      </div>
    </section>
  </main>
</BaseLayout>
